{
  "name": "ladycadmium.net",
  "description": "The codebase for ladycadmium.net",
  "author": "LadyCadmium",
  "version": "1.0.0",
  "license": "MIT",
  "keywords": [],
  "main": "index.js",
  "scripts": {
    "clean": "find dist/ -mindepth 1 ! -name '.gitkeep' -delete",
    "build:ts": "tsc",
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/style.css",
    "build:html": "cp src/index.html dist/",
    "build": "npm run build:html && npm run build:css && npm run build:ts",
    "serve": "http-server dist/ -a 0.0.0.0 -p 8080 -o",
    "dev": "npm run clean && npm run build && npm run serve"
  },
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "http-server": "^14.1.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
